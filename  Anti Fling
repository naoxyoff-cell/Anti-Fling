-- ===== Logique de protection =====
local function appliquerPoidsPerso(char)
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if hrp then
		hrp.CustomPhysicalProperties = actif and DENSE or nil
	end
end

local function restaurer()
	for part in pairs(modifies) do
		if part and part.Parent then part.CanCollide = true end
	end
	table.clear(modifies)
	appliquerPoidsPerso(lp.Character)
end

local function basculer()
	actif = not actif
	if not actif then
		restaurer()
	else
		appliquerPoidsPerso(lp.Character)
	end
	majUI()
end
lier(root.MouseButton1Click:Connect(basculer))

lier(lp.CharacterAdded:Connect(function(char)
	task.wait(0.5)
	appliquerPoidsPerso(char)
end))

-- 1) Les autres joueurs ne peuvent plus te toucher (collision locale coupée)
lier(RunService.Stepped:Connect(function()
	if not actif then return end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= lp and p.Character then
			for _, part in ipairs(p.Character:GetDescendants()) do
				if part:IsA("BasePart") and part.CanCollide then
					part.CanCollide = false
					modifies[part] = true
				end
			end
		end
	end
end))

-- 2) Annulation des vitesses / rotations folles sur toi (sans téléportation)
lier(RunService.Heartbeat:Connect(function()
	if not actif then return end
	local char = lp.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hrp or not hum or hum.SeatPart then return end -- véhicules : on ne touche pas

	local v = hrp.AssemblyLinearVelocity
	local horizontal = Vector3.new(v.X, 0, v.Z).Magnitude
	local limite = math.max(100, hum.WalkSpeed * 2.5 + 60) -- respecte ton boost de vitesse
	local rot = hrp.AssemblyAngularVelocity.Magnitude

	if horizontal > limite or rot > 30 or v.Y > 150 then
		local y = v.Y > 150 and 50 or v.Y -- chute normale conservée
		local h = Vector3.new(v.X, 0, v.Z)
		if horizontal > limite then h = h.Unit * math.min(horizontal, hum.WalkSpeed) end
		hrp.AssemblyLinearVelocity = Vector3.new(h.X, y, h.Z)
		hrp.AssemblyAngularVelocity = Vector3.zero
		bloques += 1
		flash()
	end
end))

-- 3) Détection des flingers à proximité (compteur + alerte visuelle)
task.spawn(function()
	while gui.Parent do
		task.wait(0.2)
		if actif then
			local char = lp.Character
			local mon = char and char:FindFirstChild("HumanoidRootPart")
			if mon then
				for _, p in ipairs(Players:GetPlayers()) do
					if p ~= lp and p.Character then
						local hrp = p.Character:FindFirstChild("HumanoidRootPart")
						if hrp and (hrp.Position - mon.Position).Magnitude < 40 then
							local ang = hrp.AssemblyAngularVelocity.Magnitude
							local vit = hrp.AssemblyLinearVelocity.Magnitude
							if ang > 60 or vit > 250 then
								local now = os.clock()
								if not dernierAlert[p] or now - dernierAlert[p] > 2 then
									dernierAlert[p] = now
									bloques += 1
									flash()
								end
							end
						end
					end
				end
			end
		end
	end
end)

-- Fermeture complète (croix rouge) + nettoyage à la prochaine exécution
local function fermer()
	actif = false
	restaurer()
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	pcall(function()
		local env = getgenv and getgenv() or _G
		env.__ANTIFLING_CLEAN = nil
	end)
	if gui then gui:Destroy() end
end

