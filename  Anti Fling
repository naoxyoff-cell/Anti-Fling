local function tween(obj, t, props, style)
	TweenService:Create(obj, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), props):Play()
end

local function texteSous()
	if not actif then return "Désactivé" end
	return bloques == 0 and "Protégé" or ("Protégé · " .. bloques .. " bloqué" .. (bloques > 1 and "s" or ""))
end

local function majUI()
	sous.Text = texteSous()
	tween(sous, 0.25, { TextColor3 = actif and VERT or GRIS })
	tween(pastille, 0.25, { BackgroundColor3 = actif and VERT or GRIS })
	tween(pilule, 0.25, { BackgroundColor3 = actif and VIOLET or Color3.fromRGB(40, 38, 58) })
	tween(bouton, 0.25, { Position = actif and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, Enum.EasingStyle.Back)
end

local function flash()
	stroke.Thickness = 4
	tween(stroke, 0.4, { Thickness = 2 })
	sous.Text = texteSous()
end

